# Cadena de conexión de Neon (Vercel Postgres).
# Cópiala desde el panel de Neon → Connection string → "Pooled connection".
# Guárdala en .env.local, que git ignora. Nunca la subas al repositorio.
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clave de la API de Anthropic, para el copiloto.
# Se obtiene en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"   # el más barato; claude-sonnet-5 o claude-opus-5 si hay presupuesto

# Proveedor del copiloto: "anthropic" (por defecto) o "groq".
# Si se omite, se usa Groq cuando GROQ_API_KEY existe.
# COPILOT_PROVIDER="groq"
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="openai/gpt-oss-120b"

# Identidad de la organización (visible en la interfaz y usada por los agentes).
NEXT_PUBLIC_ORG_NAME="Mi organización"
NEXT_PUBLIC_COMMITTEE_SIGNER="Comité de gobierno"
NEXT_PUBLIC_COMMITTEE_ROLE="Gobierno de TI"
# Cuántas negociaciones redacta el modelo por evaluación (el plan gratuito de Groq admite ~2/min).
# AUTHORING_BATCH=3
